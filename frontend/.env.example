# Local development proxies /api to http://localhost:5000 by default.
# Production: set this before building to your PUBLIC HTTPS backend origin.
# For the current technovahub.in deployment:
VITE_API_URL=https://technovalens.onrender.com

# This is not a workspace token. Never configure a shared workspace token here.
# For local development, use VITE_API_URL=http://localhost:5000 in .env.
