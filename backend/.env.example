# Required for Gemini-backed interpretation and PDF analysis. Keep this file private.
GEMINI_API_KEY=replace-with-your-server-side-key
PRIMARY_GEMINI_MODEL=gemini-flash-latest
# Verified with the configured development key; run `npm run verify:models` after changing projects/keys.
FALLBACK_GEMINI_MODEL=gemini-3.5-flash
# Legacy alias remains supported when PRIMARY_GEMINI_MODEL is unset.
# GEMINI_MODEL=gemini-flash-latest
PORT=5000

# Application safety controls (separate from Google's project quotas).
GEMINI_DAILY_BUDGET=15
GEMINI_USAGE_TIME_ZONE=UTC
GEMINI_MIN_INTERVAL_MS=15000
GEMINI_QUEUE_TIMEOUT_MS=180000
ANALYSIS_CACHE_TTL_MS=86400000

# Optional shared filesystem locations for multi-process deployments.
# DOCUMENT_STORE_DIR=C:/path/to/shared/technovalens/uploads

# Optional Gemini-compatible API base URL, useful for a trusted proxy or tests.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
