# Required for Gemini-backed interpretation and PDF analysis. Keep this file private.
GEMINI_API_KEY=replace-with-your-server-side-key
PRIMARY_GEMINI_MODEL=gemini-flash-latest
# Verified with the configured development key; run `npm run verify:models` after changing projects/keys.
FALLBACK_GEMINI_MODEL=gemini-3.5-flash
# Legacy alias remains supported when PRIMARY_GEMINI_MODEL is unset.
# GEMINI_MODEL=gemini-flash-latest
PORT=5000

# Required for server-side authentication. Generate a private value with
# `npm run auth:configure` (writes only the ignored local .env, never prints it).
# Configure an independent random secret in the production environment.
# SESSION_SECRET=
# Set NODE_ENV=production on HTTPS deployments. This enforces Secure cookies.
# NODE_ENV=production
# Existing frontend/backend domains are cross-site: use None + Secure on HTTPS.
# For same-site hosting, Lax is also supported. HTTP development defaults to Lax.
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=true
# Default: 1 on Render (RENDER=true), 0 elsewhere. This lets req.secure honor
# Render's HTTPS forwarding without trusting proxies on ordinary local servers.
# Override only with the exact trusted hop count. Do not expose the origin port.
# An explicit 0 overrides Render detection and rejects TLS-terminated requests.
# AUTH_TRUST_PROXY_HOPS=1
# Additional exact frontend origins, comma-separated. No wildcard or URL paths.
# Production already permits https://technovahub.in and https://www.technovahub.in.
# Use an origin only (no /technovalens path). localhost is development-only.
# AUTH_ALLOWED_ORIGINS=https://technovahub.in
# Public signup uses MongoDB, strong passwords, CSRF and per-IP rate limits.
# Optional initial-admin provisioning, after reviewing the intended database:
# run `npm run admin:setup` in a private interactive terminal.
# Passwords are entered without echo; no default password or bootstrap HTTP API.

# Existing MongoDB conversation storage is the default.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional database override; production defaults to technovalens.
# MONGODB_DB_NAME=technovalens
# File mode applies only to conversation/document storage. Accounts and sessions
# ALWAYS require MongoDB, even when this local storage option is used.
# CONVERSATION_STORAGE=file
# Read-only inspection: skips indexes/migrations and rejects storage writes.
# STORAGE_READ_ONLY=true

# Cache expiration is OFF until deletion is explicitly approved.
# One process must exclusively own this cache directory before enabling it.
LOCAL_CACHE_EXPIRATION_ENABLED=false
LOCAL_CACHE_SINGLE_PROCESS=false
LOCAL_CACHE_TTL_MS=86400000
# audit-storage.mjs is read-only by default. Never enable this on production
# without a reviewed migration and separate authorization.
# ALLOW_STORAGE_MIGRATION=true

# Application safety controls (separate from Google's project quotas).
GEMINI_DAILY_BUDGET=15
GEMINI_USAGE_TIME_ZONE=UTC
GEMINI_MIN_INTERVAL_MS=15000
GEMINI_QUEUE_TIMEOUT_MS=180000
ANALYSIS_CACHE_TTL_MS=86400000

# Optional shared filesystem locations for multi-process deployments.
# DOCUMENT_STORE_DIR=C:/path/to/shared/technovalens/uploads

# Optional Gemini-compatible API base URL, useful for a trusted proxy or tests.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Bounded spreadsheet workers. Defaults retain the original 256 MiB heap cap.
# Values are clamped: heap 128-512 MiB, workers 1-2, timeout 1000-120000 ms.
SPREADSHEET_WORKER_HEAP_MB=256
SPREADSHEET_WORKERS=1
SPREADSHEET_TIMEOUT_MS=30000
# Render Free diagnostic override ONLY (set in Render Environment, not here):
# SPREADSHEET_TIMEOUT_MS=120000
# Keep SPREADSHEET_WORKER_HEAP_MB=256 and SPREADSHEET_WORKERS=1.
# This increases the bounded observation window; it does not resolve CPU throttling.
